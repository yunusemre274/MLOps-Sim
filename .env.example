# MLOps Engineer Simulator — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# .env dosyası asla commit'lenmez (.gitignore'da tanımlı).

# --- AI Entegrasyonu (Faz 7'de aktif olacak) ---
# Gemini API anahtarı — görev değerlendirme ve senaryo üretimi için
VITE_GEMINI_API_KEY=

# --- Uygulama Ayarları ---
# Geliştirme portu (varsayılan: 5173)
VITE_DEV_PORT=5173

# AI değerlendirme modu: "ai" veya "rule" (kural tabanlı fallback)
VITE_EVAL_MODE=rule

# Günlük AI çağrı limiti (maliyet kontrolü)
VITE_AI_DAILY_LIMIT=50
